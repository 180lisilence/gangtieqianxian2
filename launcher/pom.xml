<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.steelfrontline</groupId>
    <artifactId>steel-frontline-launcher</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>钢铁前线 · 启动器</name>
    <description>内嵌 HTTP 服务器的 Java 启动器, 打开浏览器运行网页版钢铁前线 FPS 游戏</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>com.steelfrontline.launcher.SteelFrontlineLauncher</main.class>
        <!-- 游戏静态文件的源目录(项目根) -->
        <game.src.dir>${project.basedir}/..</game.src.dir>
    </properties>

    <!-- 无第三方依赖: HTTP 服务器用 JDK 自带 com.sun.net.httpserver -->
    <dependencies></dependencies>

    <build>
        <!-- 最终 jar 名: SteelFrontline.jar -->
        <finalName>SteelFrontline</finalName>
        <resources>
            <!-- 默认 src/main/resources 保留(存放 icon 等) -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- 将项目根目录的 index.html + css + js + (所有静态内容)拷贝进 classpath:/game/ -->
            <resource>
                <directory>${game.src.dir}</directory>
                <targetPath>game</targetPath>
                <includes>
                    <include>index.html</include>
                    <include>css/**</include>
                    <include>js/**</include>
                    <include>assets/**</include>
                    <include>*.png</include>
                    <include>*.jpg</include>
                    <include>*.svg</include>
                    <include>*.ico</include>
                </includes>
                <!-- 排除服务器脚本和非游戏文件 -->
                <excludes>
                    <exclude>js/engine/../**</exclude>
                    <exclude>launcher/**</exclude>
                    <exclude>server.js</exclude>
                    <exclude>*.log</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!-- 打 jar 时写入 MANIFEST.MF 使双击可运行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 打包 Windows EXE 的 profile: mvn -Pinstaller package
         会触发 jpackage 生成安装版/便携版 exe (需要 JDK 17+ 和 WiX Toolset 或 innoSetup) -->
    <profiles>
        <profile>
            <id>installer</id>
            <build>
                <plugins>
                    <!-- 先复制依赖(当前为无)和 jar 到 target/jpackage/ -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>prepare-jpackage</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/jpackage/input"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              tofile="${project.build.directory}/jpackage/input/${project.build.finalName}.jar"/>
                                        <!-- 图标: 若没有则在 exe 打包阶段用默认 -->
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
